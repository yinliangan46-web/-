<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script>
(function(){
  function boot(){
    if(typeof L==='undefined'){
      var el=document.getElementById('real-map');
      if(el) el.innerHTML='<div style="padding:22px;color:#666;font-size:13px">地图组件加载失败，请联网后刷新页面。</div>';
      return;
    }
    const days={
      1:{color:'#f27620',title:'Day 1｜五一广场 → IFS国金中心 → 太平街 → 坡子街 → 杜甫江阁',desc:'真实地图 + 实际道路路线；商圈、老街与湘江沿线。太平街、坡子街及杜甫江阁景区内部以步行为主。',center:[28.1935,112.9755],zoom:14,points:[
        ['五一广场',28.1964,112.9775],
        ['IFS国金中心',28.1968,112.9788],
        ['太平街',28.1927,112.9708],
        ['坡子街',28.1916,112.9750],
        ['杜甫江阁',28.1884,112.9677]
      ]},
      2:{color:'#187bd8',title:'Day 2｜湖南博物院 → 岳麓书院 → 爱晚亭 → 岳麓山 → 橘子洲',desc:'真实地图 + 实际道路路线；岳麓山景区内部及橘子洲内部游览以步行为主。',center:[28.1905,112.9570],zoom:12,points:[
        ['湖南博物院',28.2099,112.9930],
        ['岳麓书院',28.180397,112.940805],
        ['爱晚亭',28.180437,112.937564],
        ['岳麓山',28.1869,112.9315],
        ['橘子洲',28.1750,112.9615]
      ]},
      3:{color:'#7952d9',title:'Day 3｜天心阁 → 黄兴路步行街 → 自由活动 → 长沙南站',desc:'真实地图 + 实际道路路线；最后送站至长沙南站，具体送站时间按车次确认。',center:[28.1785,112.9930],zoom:13,points:[
        ['天心阁',28.1818,112.9800],
        ['黄兴路步行街',28.1930,112.9778],
        ['自由活动',28.1960,112.9755],
        ['长沙南站',28.1516,113.0390]
      ]}
    };
    const map=L.map('real-map',{zoomControl:true,scrollWheelZoom:true,attributionControl:true});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);
    let markers=L.layerGroup().addTo(map),routeLayer=null,routeSeq=0;
    const summary=document.getElementById('route-summary'),title=document.getElementById('route-title'),desc=document.getElementById('route-desc');
    function icon(color,num){return L.divIcon({className:'route-marker-wrap',html:'<div class="route-marker" style="background:'+color+'">'+num+'</div>',iconSize:[32,32],iconAnchor:[16,16],popupAnchor:[0,-18]});}
    function drawMarkers(d){
      markers.clearLayers();
      d.points.forEach((p,i)=>L.marker([p[1],p[2]],{icon:icon(d.color,i+1)}).bindPopup('<b>'+p[0]+'</b><br><span style="color:#777">Day '+(Object.keys(days).find(k=>days[k]===d))+' · 第'+(i+1)+'站</span>').addTo(markers));
    }
    async function drawRoadRoute(d,day){
      const seq=++routeSeq;
      if(routeLayer){map.removeLayer(routeLayer);routeLayer=null;}
      const coords=d.points.map(p=>p[2]+','+p[1]).join(';');
      const url='https://router.project-osrm.org/route/v1/driving/'+coords+'?overview=full&geometries=geojson&steps=false';
      try{
        const r=await fetch(url,{mode:'cors'});
        if(!r.ok) throw new Error('route http '+r.status);
        const data=await r.json();
        if(seq!==routeSeq) return;
        if(data.code==='Ok' && data.routes && data.routes[0]){
          routeLayer=L.geoJSON(data.routes[0].geometry,{style:{color:d.color,weight:5,opacity:.9}}).addTo(map);
          const km=(data.routes[0].distance/1000).toFixed(1), min=Math.round(data.routes[0].duration/60);
          desc.textContent=d.desc+' 预计驾车约 '+km+' km / '+min+' 分钟（路线服务动态计算，仅供行程参考）。';
        }else throw new Error('no route');
      }catch(e){
        // 公开路线服务不可用时仍保留真实地图与真实点位，不画直线冒充道路。
        desc.textContent=d.desc+' 当前无法获取道路路线服务，地图仍可正常查看各真实点位。';
      }
    }
    function render(day){
      const d=days[day];
      drawMarkers(d);
      map.setView(d.center,d.zoom,{animate:true});
      summary.innerHTML=d.points.map((p,i)=>'<span class="route-pill">'+(i+1)+' · '+p[0]+'</span>').join('');
      title.textContent=d.title; desc.textContent=d.desc;
      document.querySelectorAll('.route-tab').forEach(b=>b.classList.toggle('active',+b.dataset.day===day));
      setTimeout(()=>map.invalidateSize(),150);
      drawRoadRoute(d,day);
    }
    document.querySelectorAll('.route-tab').forEach(b=>b.addEventListener('click',()=>render(+b.dataset.day)));
    render(1);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot); else boot();
})();
</script>
</body></html>
